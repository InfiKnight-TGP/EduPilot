@startuml
title EduPilot AI - System Overview
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundcorner 12

actor Student

component "Browser UI\n(Jinja HTML templates)" as UI
component "Flask App\n(app.py)" as APP
component "Dashboard Routes\n/ /academics /timetable\n/assignments /career /wellness /attendance /chat" as ROUTES
component "API Endpoints\n/api/chat\n/api/gpa-predict\n/api/attendance-forecast" as API
component "Sample Data Layer\nStudent / Courses / Assignments\nCareer / Timetable / Wellness" as DATA
component "Rule-based AI Logic" as AI
component "JSON Responses" as JSON

Student --> UI
UI --> APP
APP --> ROUTES
APP --> API
ROUTES --> DATA
API --> AI
AI --> JSON
JSON --> UI
@enduml
